{
  "expo": {
    "name": "Kiano London",
    "slug": "kiano-london",
    "owner": "mahir93",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EBDC",
    "scheme": "kiano",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1786b49-0e68-46d1-a5f7-37c57a92f025",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "image": "./assets/images/splash-lockup.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EBDC",
      "dark": {
        "image": "./assets/images/splash-lockup.png",
        "backgroundColor": "#F2EBDC"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#F2EBDC",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "london.kiano.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "london.kiano.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2EBDC",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d1786b49-0e68-46d1-a5f7-37c57a92f025"
      }
    },
    "plugins": [
      "expo-updates",
      "expo-dev-client",
      "expo-system-ui",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1B1714",
          "defaultChannel": "word",
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EBDC",
          "image": "./assets/images/splash-lockup.png",
          "imageWidth": 252,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F2EBDC",
            "image": "./assets/images/splash-lockup.png"
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
