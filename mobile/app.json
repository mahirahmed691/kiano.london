{
  "expo": {
    "name": "Kiano London",
    "slug": "kiano-london",
    "owner": "mahir93",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EBDC",
    "scheme": "kiano",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1786b49-0e68-46d1-a5f7-37c57a92f025",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "splash": {
      "image": "./assets/images/splash-lockup.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EBDC",
      "dark": {
        "image": "./assets/images/splash-lockup.png",
        "backgroundColor": "#F2EBDC"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#F2EBDC",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "london.kiano.app",
      "associatedDomains": [
        "applinks:www.kiano.london",
        "applinks:kiano.london"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "The till may use the camera to read a card number on Stripe’s page. The house does not keep photographs."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "london.kiano.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2EBDC",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "www.kiano.london",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "kiano.london",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d1786b49-0e68-46d1-a5f7-37c57a92f025"
      }
    },
    "plugins": [
      "expo-updates",
      "expo-dev-client",
      "expo-system-ui",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1B1714",
          "defaultChannel": "word",
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EBDC",
          "image": "./assets/images/splash-lockup.png",
          "imageWidth": 252,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F2EBDC",
            "image": "./assets/images/splash-lockup.png"
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
